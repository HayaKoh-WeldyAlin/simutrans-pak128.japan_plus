dialog_tool[1]=1,Q
dialog_tool[2]=2,m
dialog_tool[3]=3,w
dialog_tool[4]=4,B
dialog_tool[5]=5,f
dialog_tool[6]=6,k
dialog_tool[7]=7
dialog_tool[8]=8
dialog_tool[9]=9
dialog_tool[10]=10
dialog_tool[11]=29,J
dialog_tool[12]=12,^O
dialog_tool[13]=13,^S
dialog_tool[14]=14,H
dialog_tool[15]=15,V
dialog_tool[16]=16,T
dialog_tool[17]=17,G
dialog_tool[18]=18,F
dialog_tool[19]=19,A
dialog_tool[20]=21
dialog_tool[21]=22
dialog_tool[22]=23
dialog_tool[23]=24
dialog_tool[24]=25
dialog_tool[25]=20 
#dialog_tool[26]= 
dialog_tool[27]=,@ 
dialog_tool[28]=26,n
dialog_tool[32]=7
dialog_tool[33]=8
dialog_tool[34]=27,R


# FINAL SECTION: すべてのツールバーを表示する
# ここですべてのツールバーを定義する
# 通常は、メインメニューであるツールバー[0]のみが必要である
# 他のすべてのツールバーはこれに基づいて作成されている
# 各エントリは a[i], b, k, c, d である
# a[i] は次のいずれかである：general_tool[i]、simple_tool[i]、dialog_tool[i]、toolbar[i]、-、ways(waytype)、signs(waytype)、wayobj(waytype)、stops(utype)、depots(waytype)
# b はmenu.ToolbarTools.pak から読み込まれた（もしあれば）以前のツール定義とは異なるアイコン、あるいはメニューパッケージの名前である可能性がある
# k には別のキーバインドが割り当てられている可能性がある
# c はデフォルトのパラメータである
# d はヘルプファイル名である（a がツールバー[i]の場合のみ）
#
# アイコンのない項目は表示されない。区切り文字として「-」を使用すること。
#
# 以下のウェイタイプが定義されている（ほぼすべてのケースに対応している）
# road_wt          =   1
# track_wt         =   2
# water_wt         =   3
# monorail_wt      =   5
# maglev_wt        =   6
# tram_wt          =   7
# narrowgauge_wt   =   8
# air_wt           =  16
# powerline_wt     = 128
#
# ways(x,#) のサブタイプ
# flat = 0
# elevated/runway = 1
# tram = 7 (only for track)
# fence = 255
#
# 以下の建物タイプが定義されている（建物(#)用）
# unbekannt         =  0
# attraction_city   =  1
# attraction_land   =  2
# denkmal           =  3
# fabrik            =  4
# rathaus           =  5
# weitere           =  6
# firmensitz        =  7
# hafen             = 11
# 以下は x,y の形式で、y=waytype（なしの場合は 0）となる
# depot = 33
# generic_stop = 34
# generic_extension = 35
#
#
# 重　要：toolbar[2]はtoolbar[1]より前に記述してはならない！
# ここでのスペースには意味がある！意図しない場合はスペースを入れないこと！
#

# toolbar[0] は常にメインメニューである
toolbar[0][0]=dialog_tool[1] #設定
toolbar[0][1]=dialog_tool[2] #マップ
toolbar[0][2]=general_tool[0] #調査
toolbar[0][3]=toolbar[1],0,,SLOPETOOLS,slopetools.txt
toolbar[0][4]=toolbar[2],69,,RAILTOOLS,railtools.txt
toolbar[0][5]=toolbar[3],2,,MONORAILTOOLS,monorailtools.txt
toolbar[0][6]=toolbar[4],8,,MAGLEVTOOLS,maglevtools.txt
toolbar[0][7]=toolbar[5],4,,NARROWGAUGETOOLS,special.txt
toolbar[0][8]=toolbar[6],5,,ROADTRAFFICTOOLS,roadtools.txt
toolbar[0][9]=toolbar[7],6,,SHIPTOOLS,shiptools.txt
toolbar[0][10]=toolbar[8],7,,AIRTOOLS,airtools.txt
toolbar[0][11]=toolbar[9],9,,SPECIALTOOLS,special.txt
toolbar[0][12]=dialog_tool[34],153,, #スクリプトツール
toolbar[0][13]=general_tool[47],155,, #スクリプトツール
# 124.4環境では実際には動作しないものであったため削除
