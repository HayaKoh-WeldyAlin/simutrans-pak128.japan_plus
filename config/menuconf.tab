§# menuconf.tab
#
# Simutransのメニュー設定
#
# 著者：Markus Pristovsek
# 編集：Kuururi Ahojanen
# 更なる編集：林田光惺（HayaKoh）

# このファイルを使用すると、各メニュー、ツール、ツールバーに意味を割り当てることができる
# 4種類のツールがある
# general_tools: like query, remove, alter land, ...
# click tools: pause, fast forward, ...
# dialoge tools: open a dialoge like minimap, settings, finances, ...
# toolbar tools: open toolbars like slope tools, road tools, ...

icon_width = 32
icon_height = 32

# FIRST SECTION: 汎用ツール
# これらのツールには、アイコンやカーソルがあり、場合によっては音も鳴る
# 各エントリは次の形式をとりる：general_tool[i],a,b,c,k
# i はツール番号である（下図参照）
# a はメニュー内のアイコンの番号（menu.GeneralTools.pak など）またはメニューパッケージの名前である
# b はcursor:cursor.GeneralTools.pak 内のカーソルを数値で表したものである
# c は成功時の音である
# k はこれを切り替えるためのキーである
# パラメータを省略すると、デフォルト値が設定される（つまり、画像なし、音声なし、ショートカットキーなし）。
# これらはデフォルトの設定である。
#
# 現在のiの値の定義
# WKZ_ABFRAGE=0

# WKZ_REMOVER=1
# WKZ_RAISE_LAND=2
# WKZ_LOWER_LAND=3
# WKZ_SETSLOPE=4
# WKZ_RESTORESLOPE=5
# WKZ_MARKER=6
# WKZ_CLEAR_RESERVATION=7
# WKZ_TRANSFORMER=8
# WKZ_ADD_CITY=9
# WKZ_CHANGE_CITY_SIZE=10
# WKZ_PLANT_TREE=11
# WKZ_FAHRPLAN_ADD=12	// シングルプレイ専用
# WKZ_FAHRPLAN_INS=13	// シングルプレイ専用
# WKZ_WEGEBAU=14 // パラメータはデフォルト値として数値の名前を含む文字列のいずれかである
# WKZ_BRUECKENBAU=15
# WKZ_TUNNELBAU=16
# WKZ_WAYREMOVER=17
# WKZ_WAYOBJ=18
# WKZ_STATION=19
# WKZ_ROADSIGN=20
# WKZ_DEPOT=21
# WKZ_BUILD_HAUS=22
# WKZ_LAND_CHAIN=23
# WKZ_CITY_CHAIN=24
# WKZ_BUILD_FACTORY=25
# WKZ_LINK_FACTORY=26
# WKZ_HEADQUARTER=27
# WKZ_LOCK_GAME=28
# WKZ_ADD_CITYCAR=29
# WKZ_FOREST=30
# WKZ_STOP_MOVER=31
# WKZ_MAKE_STOP_PUBLIC=32
# WKZ_REMOVE_WAYOBJ=33
# WKZ_UNDERGROUND_PICK=34
# WKZ_BUY_HOUSE=35
# WKZ_CITYROAD=36
# WKZ_ERR_MESSAGE_TOOL=37
# WKZ_CHANGE_WATER_HEIGHT=38
# WKZ_SET_CLIMATE=39
# WKZ_ROTATE_BUILDING=40
# WKZ_MERGE_STOP=41
# WKZ_EXEC_SCRIPT=42
# WKZ_EXEC_TWO_CLICK_SCRIPT=43
# WKZ_PLANT_GROUNDOBJ=44
# WKZ_ADD_MESSAGE=45
# WKZ_REMOVE_SIGNAL=46
# WKZ_GENERATE_SCRIPT=47
# WKZ_PIPETTE=48
#
general_tool[0]=0,0,9,a
general_tool[1]=1,1,14,r
general_tool[2]=2,2,11,u
general_tool[3]=3,3,11,d
# 汎用ツール 4 にはパラメータが必要である ⇒ ツールバーにはアイコンが定義されているが、カーソルはまだ表示されていない
general_tool[4]=,4,11
general_tool[5]=4,4,11
general_tool[6]=5,5,9,M
general_tool[7]=6,6,,b
general_tool[8]=7,7,11,g
general_tool[9]=8,8,11,C
# 汎用ツール 10 にはパラメータが必要であり、アイコンとカーソルはそれに依存する ⇒ ここでは定義されていない
general_tool[11]=9,9,9,ｧ
# 汎用ツール 12～22 は他のエントリからコンテンツを取得するが、デフォルト値を定義する必要がある
# スケジュールツールのカーソルを定義する
general_tool[12]=,10
general_tool[13]=,10
# カーソルとサウンドのみを定義する
general_tool[14]=,,11
general_tool[15]=,,12
general_tool[16]=,,9
general_tool[17]=,1,11
general_tool[18]=,,11
general_tool[19]=,,11
general_tool[20]=,,11
general_tool[21]=,,11
general_tool[22]=,12,11
general_tool[23]=,12,11
general_tool[24]=,12,11
general_tool[25]=,12,11
# pak64では、汎用ツール23～25を直接使用しない ⇒ アイコンが未定義になる
general_tool[26]=10,11,9
general_tool[27]=11,12,9,h
general_tool[28]=12,7,,
# citycarsは通常、ダイアログから追加される
general_tool[29]=,,,
general_tool[30]=13,9,,
general_tool[31]=14,11,,
general_tool[32]=15,11,,
general_tool[33]=16,1,11,
general_tool[34]=,,11,
general_tool[35]=17,,11,K
general_tool[40]=18,,15,i
general_tool[41]=19,11,,
#general_tool[44]=,,,
general_tool[46]=,1,11
general_tool[47]=,,,|
# cityroad (36) はここで設定されていない
# OTRPv32以降では従来の[44]が[47]になる。


# SECOND SECTION: シンプルツール
# これらのツールは即座に動作するため
# アイコンのみが割り当てられている
# 各エントリは次の形式をとる：dialoge_tool[i],a,k
# i はツール番号である（下図参照）
# a はメニュー内のアイコン番号（menu.SimpleTools.pak）またはメニューパッケージの名前である
# k はこの機能をオン／オフに切り替えることができるキーである
#
# WKZ_PAUSE = 0
# WKZ_FASTFORWARD = 1
# WKZ_SCREENSHOT = 2
# WKZ_INCREASE_INDUSTRY=3
# WKZ_UNDO=4
# WKZ_SWITCH_PLAYER=5
# WKZ_STEP_YEAR=6
# WKZ_CHANGE_GAME_SPEED=7
# WKZ_ZOOM_IN=8
# WKZ_ZOOM_OUT=9
# WKZ_SHOW_COVERAGE=10
# WKZ_SHOW_NAMES=11
# WKZ_SHOW_GRID=12
# WKZ_SHOW_TREES=13
# WKZ_SHOW_HOUSES=14
# WKZ_SHOW_UNDERGROUND=15
# WKZ_ROTATE90=16
# WKZ_QUIT=17
# WKZ_FILL_TREES=18
# WKZ_DAYNIGHT_LEVEL=19
# WKZ_VEHICLE_TOOLTIPS=20
# WKZ_TOOGLE_PAX=21
# WKZ_TOOGLE_PEDESTRIANS=22
# WKZ_TRAFFIC_LEVEL=23
# WKZ_CONVOI_TOOL=24
# WKZ_LINE_TOOL=25
# WKZ_DEPOT_TOOL=26 (シングルプレイ)
# WKZ_PWDHASH_TOOL=27 (シングルプレイ)
# WKZ_SET_PLAYER_TOOL=28 (シングルプレイ)
# WKZ_TRAFFIC_LIGHT_TOOL=29 (シングルプレイ)
# WKZ_CHANGE_CITY_TOOL=30 (シングルプレイ)
# WKZ_RENAME_TOOL=31 (シングルプレイ)
# WKZ_ADD_MESSAGE_TOOL=32 (シングルプレイ)
# WKZ_TOGGLE_RESERVATION=33
# WKZ_VIEW_OWNER=34
# WKZ_HIDE_UNDER_CURSOR=35
# WKZ_MOVE_MAP=36
# WKZ_ROLLUP_ALL_WIN=37
# WKZ_RECOLOUR_TOOL=38
# WKZ_SHOW_FACTORY_STORAGE=39
# WKZ_TOGGLE_CONTROL=40
# TOOL_LOAD_SCENARIO=41
# TOOL_DAY_NIGHT_TOGGLE=42
# TOOL_SINGLE_WAY_TOOGLE=43
#
simple_tool[0]=0,p
simple_tool[1]=1,W
simple_tool[2]=2,c
simple_tool[3]=3
simple_tool[4]=4,z
simple_tool[5]=5,P
simple_tool[6]=6
# simple tool 7 にはパラメータが必要である
simple_tool[8]=7,>
simple_tool[9]=8,<
# まだ描かれていないアイコンがたくさんある……
simple_tool[10]=12,v
simple_tool[11]=13,!
simple_tool[12]=10,#
simple_tool[13]=14,%
simple_tool[14]=15,"
simple_tool[15]=,U,U
simple_tool[16]=11,
# 終了 (17) は、ユーザーが誤ってゲームを終了させてしまうため削除された
#simple_tool[17]=,^Q
simple_tool[20]=,/
simple_tool[34]=16,O
simple_tool[37]=,:
# 124.4環境では実際には動作しないものであったため削除
#simple_tool[41]=18,^K

# THIRD SECTION: ダイアログツール
# これらのツールはダイアログのみを即座に開くため、
# アイコンのみが割り当てられている
# 各エントリは次の形式をとる：dialoge_tool[i],a,k
# i はツール番号である（下図参照）
# a はメニュー内のアイコンの番号（menu.DialogeTools.pak）またはメニューパックの名前である
# k はこれを切り替えるためのキーである
#
# WKZ_HELP=0
# WKZ_OPTIONEN=1
# WKZ_MINIMAP=2
# WKZ_LINEOVERVIEW=3
# WKZ_MESSAGE=4
# WKZ_FINANCES=5
# WKZ_PLAYERS=6
# WKZ_DISPLAYOPTIONS=7
# WKZ_SOUND=8
# WKZ_LANGUAGE=9
# WKZ_PLAYERCOLOR=10
# WKZ_JUMP=11
# WKZ_LOAD=12
# WKZ_SAVE=13
# WKZ_LIST_HALT=14
# WKZ_LIST_CONVOI=15
# WKZ_LIST_TOWN=16
# WKZ_LIST_GOODS=17
# WKZ_LIST_FACTORY=18
# WKZ_LIST_CURIOSITY=19
# WKZ_EDIT_FACTORY=20
# WKZ_EDIT_ATTRACTION=21
# WKZ_EDIT_HOUSE=22
# WKZ_EDIT_TREE=23
