§# simuconf.tab
#
# Low-Level values and constants
#
#
# このファイルはいろいろな場所にある:
#
# simutrans/config/simuconf.tab
# ~/simutrans/simuconf.tab (もしsingleuser_install != 0であるか、存在しなければ、最初にpakファイルのパスだけが読み込まれる)
# simutrans/pakfilefolder/config/simuconf.tab
# ~/simutrans/simuconf.tab (上記と同様に2番目に読み込まれる)
#
# pakフォルダーの中にあるため、pakに依存する値しか触れない！
#
###############################旅客##############################

# 町の成長倍率 (「electricity」は現在使われていない)
# 倍率が高いほど成長が速い
passenger_multiplier = 90
mail_multiplier = 50
goods_multiplier = 70
electricity_multiplier = 0

# 街の成長はサイズに左右される。大きさは3種類ある (<1000, 1000-10000, >10000)
# 考え方としては、面積は二乗で増加するが、成長は一次関数となっている。
growthfactor_villages = 400
growthfactor_cities = 200
growthfactor_capitals = 100

# 旅客発生数（デフォルトは16） 値が小さいほど旅客数が少ないことを意味する
passenger_factor=16

# 産業施設や名所旧跡を発着する乗客数
# 残りの割合は都市間および都市内移動である。
factory_worker_percentage = 25
tourist_percentage = 20

# 地元の観光地がどれだけ好まれているか
# 1 はほぼ地元の乗客／郵便物のみ、10000 は世界中に広がる
# エントリーは最大10件まで可能で、最初に年、次に倍率。
# 年度間の増加率は、まず緩やかに増加し、その後終盤に向けて急速に増加する
locality_factor[0]=1835,1
locality_factor[1]=1900,5
locality_factor[2]=1940,100
locality_factor[3]=1945,100
locality_factor[4]=1946,2000
locality_factor[5]=1950,2000
locality_factor[6]=1970,5000
locality_factor[7]=2000,7000
locality_factor[8]=2100,10000

# 産業施設は、factory_worker_radius 内にあるか、factory_worker_minimum_towns 以下の都市が追加され、
# factory_worker_maximum_towns 以下の都市が追加された場合、労働者の目的地として町に追加される。
# デフォルトの設定では、半径77タイルで最大4つの都市に接続している。
# factory_worker_maximum_townsをゼロに設定すると、工場は町に接続されない。
factory_worker_radius = 200
factory_worker_minimum_towns = 1
factory_worker_maximum_towns = 10

# 有効にした場合（デフォルト = 0 オフ）、停留所は旅客、郵便、貨物のために異なる容量を持つことができる。
seperate_halt_capacities = 1

# スピードボーナスによる最低所得 (1000 = 1) デフォルト125
bonus_basefactor = 400


# 3つのモード（デフォルト = 0）
# 1:支払いは次の経由地までの距離に対してのみ行われます 2:目的地までの距離に対して行われます (デフォルト0は最後の停車駅からの距離です)
pay_for_total_distance = 0

# アクティブな場合、過密な目的地へのものはロードされない（デフォルトはオフ）
avoid_overcrowding = 0

# 過密な停留所を通過するしかルートがない場合、商品／旅客／郵便物を作成しない。
no_routing_over_overcrowded = 0

# 初心者モードでは、すべての商品の価格に係数が掛けられる（デフォルト1500=1.5）
beginner_price_factor = 1500

##################################産業#################################

# 都市がこの数の2^n倍に達すると、産業施設が拡張されるか、新しい産業チェーンが生まれる。
#industry_increase_every = 4000

# 隣接する2つの工場間の最小距離
factory_spacing = 9

# すべての消費地が産業施設に接続できるようにするか？
# デフォルトのままにしておくのがベスト。(simuTTDの場合のみオン）
crossconnect_factories = 1

# 相互接続の可能性は何パーセントか
# (100%でもcrossconnect_factories=1とほぼ同じ結果になる)
crossconnect_factories_percentage = 100

# 地下に変圧器を設置できる場合はtrue（デフォルト）

allow_underground_transformers = 1

# 使用可能な総電力は（総生産量に対して）1,000分のいくらなのか
electric_promille = 330

# このスイッチをオンにすると（デフォルト）、過密状態の工場は商品を受け取れなくなる。
just_in_time = 1

# 初心者モードを使用する（新しいマップのダイアログで切り替えることができる）
first_beginner = 0

# 流通が停止するまでの輸送量
# これは "just_in_time "が有効な場合にのみ有効である。
# リミットは、工場出荷時の貯蔵量のパーセンテージで示される（0=オフ）
# 1つ以上のファクトリーで大きなコンボをフルロードできるよう、低すぎない数字であるべきだ。
# 中規模マップでは500が妥当な数字と思われる）。
maximum_intransit_percentage = 1000

# ブースト計算のために工場に到着した旅客／郵便物の量を平均化するための期間数。
# 1ピリオドは、ゲーム内で2^18ミリ秒の一定間隔を表す。
# 値は1～16の範囲で指定可能。1は平均化しないことを意味し、デフォルトは4
factory_arrival_periods = 4

# 工場の旅客／郵便需要を変化させるかどうか。
factory_enforce_demand = 1

# タイルのZ方向の高さ（デフォルト16、TTD 8）
# このファイルが「pakxyz/config」にある場合のみ使用されます！
tile_height = 8

# 古い緩急坂非対応のセーブゲームを緩急坂対応のパックでロードした場合の、古いスロープの新しい高さ (デフォルト 1=緩坂、2=急坂)
height_conversion_factor = 2

###################################表示##################################

#ゲーム画面を1秒間に何回書き換えるか（デフォルト 25 早送り 10）
frames_per_second = 25
fast_forward_frames_per_second = 25

# ランダムなオブジェクトを表示し、均一性を破る（n個のタイルごとに）
random_grounds_probability = 20

# ランダムに動く動物を表示する（n = n個のタイルごとに表示される）
random_wildlife_probability = 1000

# 各インターバルで水をアニメーション化する（画像がある場合）
# 再描画に時間がかかる(~1-3%)
water_animation_ms = 250

# プレイヤーの色は、複数のプレイヤーに対して固定することも、完全にランダムに設定することもできる。
# 後者の場合、各プレイヤーはユニークだがランダムなカラーリングを得る。
# (デフォルト 0)
random_player_colors = 1

# ここに設定すると、たとえランダムカラーが有効になっていたとしても、
# プレイヤーは常にこれらのプレイヤーカラーを得ることになる。
# 色の範囲は0から27までで、1番目と2番目のプレーヤーの色である。
# そしてゲームには0から15人のプレイヤーが参加できる
player_color[1] = 1,4

# 対角線の長さ（512：faktor 2=1024/512、古い方法、724：sqrt(2)=1024/724
# このファイルが「pakxyz/config」にある場合のみ使用されます！
diagonal_multiplier = 724

# 有効な場合、デフォルトの背景は黒
#background_color = 240

# 土の勾配を描き、境界線を示す（デフォルトは1オン）
draw_earth_border = 1

# ground.ouside.pakで外側をタイル状にする（デフォルト0オフ）
draw_outside_tile = 1

# 夜間に発光する特別色
special_color[0]=0x57, 0x65, 0x6F, 0xD3, 0xC3, 0x80 // 暗い窓、夜は黄色く照らされる
special_color[1]=0x7F, 0x9B, 0xF1, 0x80, 0xC3, 0xD3 // 明るい窓、夜は青みがかった光
special_color[2]=0xFF, 0xFF, 0x53, 0xFF, 0xFF, 0x53 // 黄色の光
special_color[3]=0xFF, 0x21, 0x1D, 0xFF, 0x21, 0x1D // 赤い光
special_color[4]=0x01, 0xDD, 0x01, 0x01, 0xDD, 0x01 // 緑の光
special_color[5]=0x6B, 0x6B, 0x6B, 0x6B, 0x6B, 0x6B // 暗くならない灰色1（メニュー）
special_color[6]=0x9B, 0x9B, 0x9B, 0x9B, 0x9B, 0x9B // 暗くならない灰色2（メニュー）
special_color[7]=0xB3, 0xB3, 0xB3, 0xB3, 0xB3, 0xB3 // 暗くならない灰色3（メニュー）
special_color[8]=0xC9, 0xC9, 0xC9, 0xC9, 0xC9, 0xC9 // 暗くならない灰色4（メニュー）
special_color[9]=0xDF, 0xDF, 0xDF, 0xDF, 0xDF, 0xDF // 暗くならない灰色5（メニュー）
special_color[10]=0xE3, 0xE3, 0xFF, 0xFF, 0xFF, 0xE3 // 昼は白に近い光、夜は黄色がかった光
special_color[11]=0xC1, 0xB1, 0xD1, 0xD3, 0xC3, 0x80 // 窓、黄色に点灯
special_color[12]=0x4D, 0x4D, 0x4D, 0xD3, 0xC3, 0x80 // 窓、黄色に点灯
special_color[13]=0xE1, 0x00, 0xE1, 0xE1, 0x00, 0xE1 // 信号用の紫色の光
special_color[14]=0x01, 0x01, 0xFF, 0x01, 0x01, 0xFF // 青い光

###################################資金##################################
#
# これらの値は通常、pakファイルで設定される。
# pakファイルに含まれていない、ゲーム内のすべてのコストを調整することができる
#

# 古いスタイル（右から左、デフォルト）または左から右のグラフを表示する。
#left_to_right_graphs  = 0

# 年棒制の新システム。最大10人のトリプレットが 可能である。エントリーは以下の形式：
# startingmoney[i]=年,金額(1/10単位),interpolate(1)またはstep(0)
starting_money[0]=1930,2000000000,1
starting_money[1]=2030,2000000000,1

# 車両基地で旧式車両(=1)を購入できるようにする。
allow_buying_obsolete_vehicles = 1

# 車は一度使用されると、その価値の一部を失うことがある。
# 損失が1000分の1である場合、つまり300の平均値は70%になる。
used_vehicle_reduction = 0

# コンボイが他のプレイヤーの所有する道路を走った場合、通行料が請求されることがある。
# この数値は、コンボイの走行コスト の割合である(必要であれば電化も含む)。
# (デフォルト 0)
toll_runningcost_percentage = 5
toll_waycost_percentage = 1

# 建物の維持費
maintenance_building = 1500

# pakファイルに含まれていない、ゲーム内のすべてのコストを調整することができる

# 最初の駅: 実際の費用は (コスト*レベル*幅*高さ) 
cost_multiply_dock=3000
cost_multiply_station=1500
cost_multiply_roadstop=700
cost_multiply_airterminal=5000
cost_multiply_post=500
cost_multiply_headquarter=10000

# 機関庫の費用
cost_depot_rail=5000
cost_depot_road=1500
cost_depot_ship=15000

# その他の道に関するもの
cost_signal=500
cost_tunnel=5000
cost_third_rail=80

# その他の建設／破壊関連
cost_alter_land=1000
cost_buy_land=1000
cost_set_slope=1000
cost_alter_climate=25000
cost_found_city=5000000
cost_multiply_found_industry=10000
cost_remove_tree=100
cost_multiply_remove_haus=500
cost_multiply_remove_field=2500

# 橋とトンネルの長さ制限
way_max_bridge_len = 50

# 停車位置をスケジュール通りにする（オフなら駅の端に停車）
stop_halt_as_scheduled=1

###################################時間###################################

# ゲームの開始年数:
# 64セットでは1850以下に設定することは推奨されない！
# 車両が見つからないという問題もあるだろうが、そうなっても文句を言わないでほしい！
# 2050年以上に設定すると、ゲームは少し退屈になる。
#
# 64で推奨される他のバージョンは1956年である。
#
starting_year = 2000

starting_month = 4
use_timeline = 2

# 日付に月を表示すべきか？
#(0=いいえ, 1=はい, 2>= 日付を表示 日本式=2, 米国式=3, ドイツ式=4)
# これは、デフォルトの長さよりも長い月を使用する場合に最も便利（下記参照）
#
show_month = 2

# グローバルタイムマルチプライヤー（新しいゲームでセーブされる）
# 2^bits_per_month=マイクロ秒の実時間で1ヶ月のゲーム内時間
# デフォルトは18。例えば、21の場合、その月は実時間で2^3=8倍長くなる。
# 生産コストと維持コストはそれに応じて調整される。
#
bits_per_month = 24

##################################森#################################
#  これらの値は、スパンツリーの数 -> メモリ消費量に影響する。
#
# タイルごとの木の本数 2 - 最低限、3は良い、4はとても見栄えが良い
max_no_of_trees_on_square = 3

# ベースとなる森林の大きさ - 最小限の森林の大きさ - 地図に依存しない
forest_base_size = 36

# 地図サイズの除数 - 小さければ小さいほど、個々の森林は大きくなる
forest_map_size_divisor = 38

# 森林数の除数 - 小さいほど、より多くの森林が生成される。
forest_count_divisor = 32

# どの程度の密度で予備の樹木を植えるかを決定する（反比例に働く）
forest_inverse_spare_tree_density = 400

# 樹木が生い茂る気候 (1:水、2:砂漠、4:熱帯、8:地中海、16:温帯、32:ツンドラ、64:岩場、128:極気候)
# ゼロ（デフォルト）は、タイルごとに少なくとも1本の木がある気候がないことを意味する
tree_climates = 0

# 木がまったくない気候（現時点では極気候のみ）
no_tree_climates = 128

# 0: 木は一切作成されません（メモリを約30％節約し、
# 小型マシンなら、季節の切り替えがずっとスムーズに行える）
# 1: 通常の楕円林における樹木の分布
# 2: 湿度に基づく気候生成が有効になっている場合、湿度に基づいて木を配置する（そうでない場合は1を使用する）
tree_distribution = 2

################################# 地形 #################################
# 新しい地図におけるデフォルトの最低水位（海面）
groundwater = 0
max_mountain_height = 320
map_roughness = 3
winter_snowline = 7

# 気候の高さ = 最低, 最高
desert_height     = -3,1
tropic_height     = -3,5
mediterran_height = -2,11
temperate_height  =  0,11
tundra_height     =  4,11
rocky_height      =  6,15
arctic_height     = 13,20

# もう一方は湿度に拠るもの
climate_temperature_borders[0]=25
climate_temperature_borders[1]=20
climate_temperature_borders[2]=15
climate_temperature_borders[3]=0
climate_temperature_borders[4]=-10
desert_humidity = 20
tropic_humidity = 80
moisture_change_land = 1
moisture_change_water = 1

# どの気候ジェネレーターが好ましいか（現時点では`heights`=高度と`humidity`=湿度のみ）
climate_generator = humidity

# 気候パッチの相対的な大きさ（変更しない方がよい）
patch_size_percentage = 15

# 湖の生成における最大水位 (-128以下または`groundwater`以下=湖なし)
lake_height = 0

###################################その他##################################

# 都市の最小間隔（デフォルトは16）
minimum_city_distance = 64

# どの程度の人口になれば新しい産業施設が必要になるのか？
industry_increase_every = 1500

# 最初の都市間道路接続の最大長
# マップの作成速度を上げたい場合は、この値を下げてください。
# 最初の都市間道路を増やしたい場合は、この値を上げてください。
# 4000なら、可能ならほぼすべての都市を結ぶ
# 注：これによりマップの作成が大幅に遅くなります！
#
intercity_road_length = 740

# 最初の都市間道路のタイプ - PAKファイルとして利用可能でなければならない。
# フォールバック(PAKが見つからない場合)は "asphalt_road"となる

intercity_road[3] = jpp_road_Strecke30,0,1885
intercity_road[2] = jpp_road_Schotterstrasse30,1885,1920
intercity_road[1] = jpp_road_Schotterstrasse50,1920,1960
intercity_road[0] = jpp_road_Strasse60,1960

# 市道の種類 - PAKファイルとして利用可能でなければならない。
# 順序はランダム
# 書式はbesch_name[,into_year[,retire_year]]である。
# introまたはretireが与えられない場合、pakのデフォルトの日付が使用される。

city_road[2] = jpp_road_Strecke20,0,1920
city_road[1] = jpp_road_Schotterstrasse40,1920,1955
city_road[0] = jpp_road_Strasse40,1955


# 河川:
# 最も大きい数値が最も小さい。max_speed==0 の河川は船が航行できない。
river_type[0] = river01


# 16から始める（あまり大きくないマップではきれいに見える）
river_number = 0

# 河川の最短の長さ（短すぎないこと）
river_min_length = 16

# 河川の最長の長さ (長すぎないこと?)
river_max_length = 256


# (=1) 左側通行
drive_left = 1
signals_on_left = 0

# それぞれの情報ウィンドウの表示
pedes_and_car_info = 0
tree_info = 0
ground_info = 0
townhall_info = 1
only_single_info = 1
