§# cityrules.tab
#
# 都市構築規則 (新形式)
#


# 改築と新築のチャンス（数字が大きい⇒発展しない）
renovation_percentage = 2

# この値より大きいときのみ市域を拡大する（単位：％）
minimum_building_desity = 1

#
# 特定の建物タイプに対する相対的な親和性により、特定の建物タイプが集積する可能性がある。
#

# resはindに隣接することを避けようとする
res_start_score = 0
res_near_ind = -8
res_near_com = 2
res_near_res = 8

# comの隣に建つべき建物としては基本的にどれも良い
com_start_score = -10
com_near_ind = 1
com_near_com = 8
com_near_res = 3

# resの隣にindが建てば少し面倒くさいのでこれまた避けたいところ・・・
ind_start_score = 0
ind_near_ind = 8
ind_near_com = 0
ind_near_res = -6

# 同じクラスタに属す/属さない場合に出現率に乗算/除算する値
# 値が大きい⇒同系の建物が集積、値が小さい⇒ばらつきが出やすい
cluster_factor = 20

#
# ここからは構築規則になる。最大で7x7までが可能だ。
# サイズは3x3、5x5、7x7！
#

#
# 規則の意味:
# S = 道路でない
# s = 道路である
# n = 空き地である
# H = 建物でない
# h = 建物である
# T = 駅関連建築物でない	// 88.03.3にて追加
# t = 駅関連建築物である // 88.03にて追加
# U = 坂道を許可する
# u = 坂道を禁止する
# . = 何でも良い
# 空白 = 次の行へ
#
# 各行には全く同じ数の規則が記述されねばいけない
#


