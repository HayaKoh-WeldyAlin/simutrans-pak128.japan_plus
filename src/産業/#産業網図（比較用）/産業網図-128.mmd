  wool & cotton --> textile_factory[織物工場] --> textile([織物])
  Plastik & Stahl & Bretter --> classical_goods_factory[雑貨工場] --> goods_([雑貨])
  goods_ & electronics & textile --> shopping_mall[ショッピングモール]
