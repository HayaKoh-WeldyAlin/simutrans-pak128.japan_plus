  meat & fish & flour --> food_processing_plant[食品工場] --> food([食品])
  grain & glass --> brewery[醸造所] --> beer([ビール])
  food & canned_food & beer --> supermarket[スーパーマーケット]
  waste_disposal[ゴミ集積場] --> waste([廃棄物])
  waste --> waste_incinerator_kraftwerk[ゴミ償却発電所]
